{
  "name": "dsh-pdf-edit",
  "version": "0.4.1",
  "description": "Style-locked PDF editor plugin for DeepSeek Harness — AI edits text, native renderer preserves layout (ships dsh-std Community v0.15 manifest + legacy dsh entry)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-std",
    "community-v0.15",
    "pdf",
    "pdf-edit",
    "style-locked",
    "ai-editor",
    "cordis"
  ],
  "author": "whatsmore-nf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Whatsmore-nf/dsh-pdf-edit.git"
  },
  "homepage": "https://github.com/Whatsmore-nf/dsh-pdf-edit#readme",
  "bugs": {
    "url": "https://github.com/Whatsmore-nf/dsh-pdf-edit/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc --skipLibCheck",
    "dev": "tsc --watch --skipLibCheck",
    "lint": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "verify": "npm run -s lint && npm run -s test",
    "fixtures": "node --experimental-strip-types test/fixtures/write-all.mts",
    "bench": "npm run -s build && node --experimental-strip-types test/benchmark/run.mjs",
    "bench:llm": "npm run -s build && node --experimental-strip-types test/benchmark/run.mjs --llm",
    "fetch:samples": "bash test/fixtures/fetch-samples.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0"
  },
  "optionalDependencies": {
    "puppeteer-core": "^23.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "pdfjs-dist": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}